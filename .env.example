# Número comercial do WhatsApp com DDI e DDD, só dígitos (ex.: 55 + DDD + número).
# O padrão versionado fica em .env; use .env.local para testar outro número.
# Obrigatório no build da Cloudflare Pages: sem ele o build falha de propósito.
VITE_WHATSAPP_NUMBER=

# URL pública final, sem barra no fim (ex.: https://www.seudominio.com.br).
# Opcional: quando definida, gera canonical, og:url, og:image absoluta e sitemap.xml.
VITE_SITE_URL=
